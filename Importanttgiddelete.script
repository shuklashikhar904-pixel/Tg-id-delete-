@bot.on(events.CallbackQuery(pattern=rb"^smsg:"))
async def cb_smsg(event):
    uid = event.sender_id
    if not is_super(uid):
        await event.answer("owner only"); return
    msg_id = event.data.decode().split(":", 1)[1]
    inbox = load_support()
    entry = inbox.get(msg_id)
    if not entry:
        await event.answer("gone"); return
    text = (f"**📩 SUPPORT MESSAGE**\n\n"
            f"from: @{entry.get('from_username','?')} (id `{entry.get('from_id')}`)\n\n"
            f"{entry.get('text','')}")
    await event.edit(text, buttons=[
        [Button.inline("↩  REPLY", data=f"sreply:{msg_id}".encode())],
        [Button.inline("◀  BACK", data=b"menu:support_inbox")],
    ])


@bot.on(events.CallbackQuery(pattern=rb"^sreply:"))
async def cb_sreply(event):
    uid = event.sender_id
    if not is_super(uid):
        await event.answer("owner only"); return
    msg_id = event.data.decode().split(":", 1)[1]
    inbox = load_support()
    entry = inbox.get(msg_id)
    if not entry:
        await event.answer("gone"); return
    _ui[uid] = {"stage": "await_support_reply", "reply_to": msg_id}
    await event.edit(
        f"**↩ REPLY to @{entry.get('from_username','?')}**\n\n"
        f"type your reply and send it.",
        buttons=[[Button.inline("❌  CANCEL", data=b"menu:support_inbox")]],
    )


@bot.on(events.CallbackQuery(pattern=rb"^noop$"))
async def cb_noop(event):
    await event.answer()


@bot.on(events.NewMessage())
async def text_input(event):
    uid = event.sender_id
    if not (is_super(uid) or is_admin(uid) or is_user(uid)):
        return
    text = (event.raw_text or "").strip()

    state = _ui.get(uid) or {}

    if state.get("stage") == "await_capture_forward":
        fwd = None
        try:
            if event.message and getattr(event.message, "forward", None):
                fwd = event.message.forward
        except Exception:
            fwd = None
        captured_id = None
        captured_name = None
        if fwd is not None:
            captured_id = getattr(fwd, "from_id", None)
            captured_name = getattr(fwd, "from_name", None)
            if captured_id is not None:
                captured_id = getattr(captured_id, "user_id", captured_id)
        if not captured_id and text:
            kind, value = parse_target(text)
            if kind == "id":
                captured_id = int(value)
                captured_name = f"user{value}"
            elif kind == "username":
                try:
                    ent = await bot.get_entity("@" + value)
                    captured_id = ent.id
                    captured_name = "@" + value
                except Exception as ex:
                    await event.reply(f"❌ couldn't resolve @{value}: {ex}")
                    return
        if captured_id is None:
            await event.reply(
                "❌ couldn't get an id.\n"
                "forward a message from the user, or send `@username`, or send `1234567890`."
            )
            return
        _ui.pop(uid, None)
        await event.reply(
            f"✅ **id captured**\n\n"
            f"user: `{captured_name}`\n"
            f"numeric id: `{captured_id}`\n\n"
            f"copy the id to grant premium:\n"
            f"`{captured_id} 30`",
            buttons=[[Button.inline("◀  MENU", data=b"menu:main")]],
        )
        return

    if not text or text.startswith("/"):
        return

    for phone, who in list(_active_connect.items()):
        if who == uid:
            if deliver_code(phone, text):
                await event.reply("✅ code received. processing...")
                return

    stage = state.get("stage")

    if stage == "await_phone":
        phone = text if text.startswith("+") else "+" + text
        if not re.match(r"^\+\d{7,15}$", phone):
            await event.reply("❌ not a valid phone. try again with `+` format.")
            return
        append_account(phone)
        _ui.pop(uid, None)
        await event.reply("✅ queued.", buttons=[
            [Button.inline("🔗  LINK IT NOW", data=b"menu:connect")],
            [Button.inline("◀  MENU", data=b"menu:main")],
        ])
        return

    if stage == "await_target":
        kind, value = parse_target(text)
        if not kind:
            await event.reply(
                "❌ not valid.\n"
                "send `@username` or numeric id like `1234567890`."
            )
            return
        target = "@" + value if kind == "username" else int(value)
        _ui[uid] = {"stage": "pick_reason", "target": target}
        shown = "@" + value if kind == "username" else value
        await event.reply(f"target: **{shown}**\npick reason:",
                          buttons=reason_buttons())
        return

    if stage == "await_add_admin":
        if not is_super(uid):
            _ui.pop(uid, None); return
        kind, value = parse_target(text)
        if not kind:
            await event.reply("❌ need `@name` or numeric id.")
            return
        if count_admins() >= MAX_ADMINS:
            await event.reply(f"❌ admin slots full ({MAX_ADMINS}/{MAX_ADMINS}).")
            _ui.pop(uid, None)
            return
        try:
            if kind == "id":
                entity = await bot.get_entity(int(value))
                username = str(value)
            else:
                entity = await bot.get_entity("@" + value)
                username = value
        except Exception as ex:
            await event.reply(f"❌ couldn't resolve {value}: {ex}")
            return
        add_admin(entity.id, username)
        _ui.pop(uid, None)
        await event.reply(f"✅ added admin `{username}` (id={entity.id})", buttons=[
            [Button.inline("◀  ADMINS", data=b"menu:admins")],
        ])
        return

    if stage == "await_grant_premium":
        if not (is_super(uid) or is_admin(uid)):
            _ui.pop(uid, None); return
        m = re.match(r"^\s*@?([\w\d]+)\s+(\d+)\s*$", text)
        if not m:
            await event.reply(
                "❌ format: `@username 30` or `1234567890 30`"
            )
            return
        target_token = m.group(1)
        try:
            days = int(m.group(2))
        except ValueError:
            await event.reply("❌ days must be a number.")
            return
        if days < 1 or days > 3650:
            await event.reply("❌ days 1-3650.")
            return
        try:
            if target_token.isdigit():
                entity = await bot.get_entity(int(target_token))
                display = target_token
                store_username = target_token
            else:
                entity = await bot.get_entity("@" + target_token)
                display = "@" + target_token
                store_username = target_token
        except Exception as ex:
            await event.reply(f"❌ couldn't resolve {target_token}: {ex}")
            return
        grant_user_premium(entity.id, store_username, days)
        _ui.pop(uid, None)
        await event.reply(
            f"✅ granted premium to **{display}** for **{days} days**\nid: `{entity.id}`",
            buttons=[[Button.inline("◀  PREMIUM LIST", data=b"menu:premium_list")]],
        )
        try:
            await bot.send_message(
                entity.id,
                f"💎 **premium granted**\n\n"
                f"you have been given **{days} days** of premium.\n\n"
                f"/start to begin.",
            )
        except Exception:
            pass
        return

    if stage == "await_support_msg":
        _ui.pop(uid, None)
        try:
            sender = await event.get_sender()
        except Exception:
            sender = None
        from_username = getattr(sender, "username", None) or "unknown"
        from_id = event.sender_id
        msg_id = f"{from_id}_{int(datetime.now(timezone.utc).timestamp())}"
        inbox = load_support()
        inbox[msg_id] = {
            "from_id": from_id,
            "from_username": from_username,
            "text": text,
            "preview": text[:40],
            "ts": datetime.now(timezone.utc).isoformat(),
        }
        save_support(inbox)
        await event.reply("✅ sent. the owner will see it.", buttons=[
            [Button.inline("◀  MENU", data=b"menu:main")],
        ])
        if SUPER_ID:
            try:
                await bot.send_message(
                    SUPER_ID,
                    f"📩 **new support msg**\nfrom: @{from_username} (id `{from_id}`)\n\n{text}",
                    buttons=[[Button.inline("📬  OPEN INBOX", data=b"menu:support_inbox")]],
                )
            except Exception:
                pass
        return

    if stage == "await_support_reply":
        reply_to = state.get("reply_to")
        _ui.pop(uid, None)
        inbox = load_support()
        entry = inbox.get(reply_to)
        if not entry:
            await event.reply("❌ gone.")
            return
        target_id = entry.get("from_id")
        try:
            await bot.send_message(target_id, f"📬 **owner reply:**\n\n{text}")
            await event.reply("✅ reply sent.", buttons=[[Button.inline("📬  INBOX", data=b"menu:support_inbox")]])
        except Exception as ex:
            await event.reply(f"❌ could not send: {ex}")
        return

    kind, value = parse_target(text)
    if kind:
        allowed = is_super(uid) or is_admin(uid)
        if not allowed and is_user_granted_premium(uid):
            allowed = is_user_premium(uid)
        if allowed:
            target = "@" + value if kind == "username" else int(value)
            _ui[uid] = {"stage": "pick_reason", "target": target}
            shown = "@" + value if kind == "username" else value
            await event.reply(f"target: **{shown}**\npick reason:",
                              buttons=reason_buttons())
            return


async def main():
    global SUPER_ID
    await bot.start(bot_token=BOT_TOKEN)

    try:
        entity = await bot.get_entity("@" + SUPER_ADMIN_USERNAME)
        SUPER_ID = entity.id
        print(f"[*] owner: @{SUPER_ADMIN_USERNAME} (id={SUPER_ID})")
    except Exception as e:
        print(f"[!] could not resolve @{SUPER_ADMIN_USERNAME}: {e}")

    admins = load_admins()
    if SUPER_ID and str(SUPER_ID) not in admins:
        admins[str(SUPER_ID)] = {"username": SUPER_ADMIN_USERNAME, "super": True}
        save_admins(admins)
        print(f"[*] owner registered.")

    if SUPER_ID is None:
        @bot.on(events.NewMessage(incoming=True, func=lambda e: e.is_private))
        async def _catch(ev):
            global SUPER_ID
            sender = await ev.get_sender()
            uname = getattr(sender, "username", None)
            if uname and uname.lower() == SUPER_ADMIN_USERNAME.lower():
                SUPER_ID = sender.id
                admins = load_admins()
                admins[str(sender.id)] = {"username": uname, "super": True}
                save_admins(admins)
                print(f"[*] owner captured: {SUPER_ID}")

    print("[*] bot online.")
    print(f"[*] linked accounts: {len(list_sessions())}")
    print(f"[*] api pairs: {len(API_POOL)}")
    print(f"[*] admins: {count_admins()}/{MAX_ADMINS}")
    print(f"[*] premium users: {count_user_premiums()}")

    await bot.run_until_disconnected()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n[*] shut down.")
