    return {}


def save_stats(stats):
    STATS_FILE.write_text(json.dumps(stats, indent=2))


def load_session_api():
    if SESSION_API_FILE.exists():
        try:
            return json.loads(SESSION_API_FILE.read_text())
        except Exception:
            return {}
    return {}


def save_session_api(session_name: str, api_id: int, api_hash: str, region: str, label: str, owner_id: int = None):
    data = load_session_api()
    prev = data.get(session_name, {})
    data[session_name] = {
        "api_id": api_id, "api_hash": api_hash, "region": region, "label": label,
        "owner_id": owner_id if owner_id is not None else prev.get("owner_id"),
    }
    SESSION_API_FILE.write_text(json.dumps(data, indent=2))


def get_session_api(session_name: str):
    entry = load_session_api().get(session_name)
    if not entry:
        return None
    return entry["api_id"], entry["api_hash"]


def session_owner(session_name: str):
    entry = load_session_api().get(session_name)
    if not entry:
        return None
    return entry.get("owner_id")


def append_account(phone: str):
    if not ACCOUNTS_FILE.exists():
        ACCOUNTS_FILE.write_text("")
    existing = [l.strip() for l in ACCOUNTS_FILE.read_text().splitlines() if l.strip()]
    if phone in existing:
        return False
    with ACCOUNTS_FILE.open("a") as f:
        f.write(phone + "\n")
    return True


def remove_account(phone: str):
    sess = SESSION_DIR / (phone.replace("+", "") + ".session")
    removed = False
    if sess.exists():
        sess.unlink(); removed = True
    if ACCOUNTS_FILE.exists():
        lines = [l for l in ACCOUNTS_FILE.read_text().splitlines() if l.strip() != phone]
        ACCOUNTS_FILE.write_text("\n".join(lines) + ("\n" if lines else ""))
    data = load_session_api()
    data.pop(phone.replace("+", "") + ".session", None)
    SESSION_API_FILE.write_text(json.dumps(data, indent=2))
    return removed


# ─────────────────── CONNECT ──────────────────────────────────
_code_futures = {}
_connect_lock = asyncio.Lock()


async def connect_one(phone: str, preferred_api: int = None, owner_id: int = None, max_resends: int = 5) -> dict:
    session_path = str(SESSION_DIR / phone.replace("+", ""))
    session_name = os.path.basename(session_path) + ".session"
    session_file = Path(session_path + ".session")

    ordered = ordered_pairs_for(phone, preferred=preferred_api)
    print(f"\n[*] connecting {phone} — {len(ordered)} pair(s) available")

    for attempt, (api_id, api_hash, region, label) in enumerate(ordered, 1):
        if session_file.exists():
            try: session_file.unlink()
            except Exception: pass

        print(f"[*] attempt {attempt}/{len(ordered)} — {label} (api_id={api_id})")
        client = TelegramClient(session_path, api_id, api_hash)

        try:
            await client.connect()
            print(f"[*] {label}: connected to telegram")

            if await client.is_user_authorized():
                me = await client.get_me()
                print(f"[+] {phone} already linked as {me.username or me.id}")
                await client.disconnect()
                save_session_api(session_name, api_id, api_hash, region, label, owner_id=owner_id)
                return {"ok": True, "message": f"already linked via {label}"}

            print(f"[*] {label}: requesting code from telegram...")
            try:
                sent = await client.send_code_request(phone)
                print(f"[+] {label}: code REQUESTED")
                print(f"[+] {label}: delivery = {sent.type.__class__.__name__}")
            except FloodWaitError as e:
                print(f"[x] {label}: FLOOD_WAIT {e.seconds}s. next pair...")
                try: await client.disconnect()
                except Exception: pass
                continue

            resend_count = 0
            signed_in = False

            while not signed_in:
                print(f"[*] {label}: WAITING FOR CODE IN CHAT...")
                code = await wait_for_code(phone)
                if code is None:
                    print(f"[x] {label}: timeout. next pair...")
                    break

                code = code.strip().replace(" ", "")
                print(f"[*] {label}: code from chat: '{code}'")

                if code.lower() in ("resend", "again", "r"):
                    if resend_count >= max_resends:
                        print(f"[x] {label}: resend limit. next pair...")
                        break
                    resend_count += 1
                    try:
                        sent = await client.send_code_request(phone)
                        print(f"[+] {label}: fresh code ({resend_count}/{max_resends})")
                        continue
                    except FloodWaitError as e:
                        print(f"[x] flood {e.seconds}s. next pair...")
                        break

                try:
                    await client.sign_in(phone, code, phone_code_hash=sent.phone_code_hash)
                    signed_in = True
                    print(f"[+] {label}: SIGN IN OK")
                except SessionPasswordNeededError:
                    print(f"[*] {label}: 2FA needed")
                    pw = await wait_for_code(phone)
                    if pw is None:
                        break
                    await client.sign_in(password=pw.strip())
                    signed_in = True
                    print(f"[+] {label}: 2FA OK")
                except (PhoneCodeExpiredError, PhoneCodeInvalidError) as e:
                    print(f"[x] {label}: {type(e).__name__}")
                    if resend_count >= max_resends:
                        break
                    resend_count += 1
                    try:
                        sent = await client.send_code_request(phone)
                        print(f"[+] {label}: fresh code ({resend_count}/{max_resends})")
                    except FloodWaitError as e2:
                        print(f"[x] flood {e2.seconds}s. next pair...")
                        break

            if signed_in:
                me = await client.get_me()
                print(f"[+] {phone} LINKED as {me.username or me.id} via {label}")
                await client.disconnect()
                save_session_api(session_name, api_id, api_hash, region, label, owner_id=owner_id)
                return {"ok": True, "message": f"linked via {label}"}

            try: await client.disconnect()
            except Exception: pass
            continue

        except Exception as e:
            err = f"{type(e).__name__}: {e}"
            print(f"[x] {label} failed: {err}")
            try: await client.disconnect()
            except Exception: pass
            low = err.lower()
            if any(k in low for k in ("api_id", "api_hash", "phone", "expired", "invalid", "flood", "auth")):
                continue
            return {"ok": False, "message": err}

    return {"ok": False, "message": f"failed on all {len(ordered)} pair(s)"}


async def wait_for_code(phone: str, timeout: int = 600) -> str:
    loop = asyncio.get_event_loop()
    fut = loop.create_future()
    _code_futures[phone] = fut
    try:
        return await asyncio.wait_for(fut, timeout=timeout)
    except asyncio.TimeoutError:
        _code_futures.pop(phone, None)
        return None


def deliver_code(phone: str, code: str) -> bool:
    fut = _code_futures.get(phone)
    if fut and not fut.done():
        fut.set_result(code)
        _code_futures.pop(phone, None)
        return True
    return False


# ─────────────────── REPORTER ─────────────────────────────────
async def report_from_session(session_path, target_username, reason_obj):
    session_name = os.path.basename(session_path)
    bound = get_session_api(session_name)
    if bound:
        api_id, api_hash = bound
    else:
        api_id, api_hash, _, _ = API_POOL[abs(hash(session_name)) % len(API_POOL)]

    client = TelegramClient(session_path, api_id, api_hash)
    result = {"session": session_name, "ok": False, "error": None}
    try:
        await client.connect()
        if not await client.is_user_authorized():
            result["error"] = "not_authorized"
            return result
        try:
            target = await client.get_entity(target_username)
        except Exception as e:
            result["error"] = f"resolve_fail: {str(e)[:100]}"
            return result
        peer = await client.get_input_entity(target)
        req = call_report_request(client, peer, reason_obj)
        await client(req)
        result["ok"] = True
    except FloodWaitError as e:
        result["error"] = f"flood_wait: {e.seconds}s"
    except Exception as e:
        result["error"] = str(e)[:200]
    finally:
        try: await client.disconnect()
        except Exception: pass
    return result


async def run_report(target_username, reason_key: str = None, progress_cb=None, viewer_uid: int = None):
    reason_key = reason_key or DEFAULT_REASON
    sessions = list_sessions()
    if not sessions:
        return {"error": "no_sessions_linked", "total": 0, "ok": 0, "fail": 0, "results": []}
    reason_obj = get_reason_obj(reason_key)
    if reason_obj is None:
        return {"error": "could_not_resolve_report_reason", "total": 0, "ok": 0, "fail": 0, "results": []}
    results, ok_count = [], 0

    for i, sess in enumerate(sessions, 1):
        path = str(SESSION_DIR / sess)
        try:
            r = await report_from_session(path, target_username, reason_obj)
        except Exception as e:
            r = {"session": sess, "ok": False, "error": f"crash: {e}"}
        results.append(r)
        if r["ok"]: ok_count += 1
        if progress_cb:
            try: await progress_cb(i, len(sessions), sess, r["ok"], viewer_uid)
            except Exception: pass
        await asyncio.sleep(COOLDOWN_SECONDS)

    summary = {"target": str(target_username), "reason": reason_key, "total": len(sessions),
               "ok": ok_count, "fail": len(sessions) - ok_count, "results": results}
    stats = load_stats()
    key = str(target_username)
    stats.setdefault(key, {"ok": 0, "fail": 0, "runs": 0})
    stats[key]["ok"] += ok_count
    stats[key]["fail"] += summary["fail"]
    stats[key]["runs"] += 1
    save_stats(stats)
    return summary


# ─────────────────── FORCE-JOIN ───────────────────────────────
async def is_joined_required(uid: int) -> bool:
    try:
        for ch in REQUIRED_CHANNELS:
            try:
                await bot.get_permissions(ch, uid)
            except UserNotParticipantError:
                return False
            except (ChannelPrivateError, ValueError):
                return False
            except Exception:
                return False
        return True
    except Exception:
        return False


