            [Button.inline("🎯  REPORT USER / ID", data=b"menu:report"),
             Button.inline("📣  REPORT CHANNEL", data=b"menu:report_channel")],
            [Button.inline("🆔  CAPTURE USER ID", data=b"menu:capture_id")],
            [Button.inline("💎  GRANT PREMIUM", data=b"menu:grant_premium"),
             Button.inline("👥  PREMIUM LIST", data=b"menu:premium_list")],
            [Button.inline("💬  HELP", data=b"menu:support")],
            [Button.inline("✖  CLOSE", data=b"menu:close")],
        ]

    return [
        [Button.inline("🎯  REPORT USER / ID", data=b"menu:report"),
         Button.inline("📣  REPORT CHANNEL", data=b"menu:report_channel")],
        [Button.inline("💬  HELP", data=b"menu:support"),
         Button.inline("📞  CONTACT ADMIN", data=b"menu:contact_admin")],
        [Button.inline("✖  CLOSE", data=b"menu:close")],
    ]


def pair_buttons():
    rows = []
    for api_id, _, region, label in API_POOL:
        rows.append([
            Button.inline(f"🔑  {label}  ·  {region}  ·  {api_id}",
                          data=f"pair:{api_id}".encode())
        ])
    rows.append([Button.inline("◀  BACK", data=b"menu:connect")])
    return rows


def reason_buttons():
    rows, row = [], []
    for key, spec in REPORT_REASONS.items():
        row.append(Button.inline(spec["label"], data=f"reason:{key}".encode()))
        if len(row) == 2:
            rows.append(row); row = []
    if row:
        rows.append(row)
    rows.append([Button.inline("◀  BACK", data=b"menu:main")])
    return rows


def phone_buttons():
    phones = []
    if ACCOUNTS_FILE.exists():
        phones = [l.strip() for l in ACCOUNTS_FILE.read_text().splitlines() if l.strip()]
    pending = [p for p in phones if not (SESSION_DIR / (p.replace("+", "") + ".session")).exists()]
    rows = [[Button.inline(f"📱  {p}", data=f"phone:{p}".encode())] for p in pending[:20]]
    rows.append([Button.inline("◀  BACK", data=b"menu:main")])
    return rows, len(pending)


def linked_accounts_buttons(uid):
    sessions = list_sessions()
    bound = load_session_api()
    is_sup = is_super(uid)
    rows = []
    for s in sessions:
        info = bound.get(s, {})
        if not is_sup:
            continue
        display = s[:-8]
        label = f"📱  {display}  ·  {info.get('label','?')}"
        rows.append([Button.inline(label, data=f"acct:{s[:-8]}".encode())])
    if not rows:
        rows.append([Button.inline("(no accounts)", data=b"noop")])
    rows.append([Button.inline("◀  BACK", data=b"menu:main")])
    return rows


def account_detail_buttons(phone, uid):
    rows = []
    if is_super(uid):
        rows.append([Button.inline("🗑  UNLINK THIS ACCOUNT", data=f"unlink:{phone}".encode())])
    rows.append([Button.inline("◀  BACK", data=b"menu:list")])
    return rows


def admin_list_buttons():
    admins = load_admins()
    rows = []
    for uid_str, info in admins.items():
        if info.get("super"):
            continue
        label = f"👤  @{info.get('username','?')}"
        rows.append([Button.inline(label, data=f"adm:{uid_str}".encode())])
    if not rows:
        rows.append([Button.inline("(no admins)", data=b"noop")])
    rows.append([Button.inline("◀  BACK", data=b"menu:main")])
    return rows


def admin_detail_buttons(uid_str):
    rows = [[Button.inline("❌  REMOVE THIS ADMIN", data=f"revoke:{uid_str}".encode())]]
    rows.append([Button.inline("◀  BACK", data=b"menu:admins")])
    return rows


def premium_list_buttons():
    users = load_users()
    rows = []
    for uid_str, info in users.items():
        if not info.get("premium"):
            continue
        exp = user_premium_expiry_str(int(uid_str))
        label = f"💎  @{info.get('username','?')} · {exp}"
        rows.append([Button.inline(label, data=f"puser:{uid_str}".encode())])
    if not rows:
        rows.append([Button.inline("(no premium users)", data=b"noop")])
    rows.append([Button.inline("◀  BACK", data=b"menu:main")])
    return rows


def support_inbox_buttons():
    inbox = load_support()
    rows = []
    for msg_id, entry in list(inbox.items())[-20:]:
        label = f"📩  @{entry.get('from_username','?')} · {entry.get('preview','')[:20]}"
        rows.append([Button.inline(label, data=f"smsg:{msg_id}".encode())])
    if not rows:
        rows.append([Button.inline("(no messages)", data=b"noop")])
    rows.append([Button.inline("◀  BACK", data=b"menu:main")])
    return rows


# ─────────────────── BOT ──────────────────────────────────────
BOT_API_ID, BOT_API_HASH, _, _ = API_POOL[0]
bot = TelegramClient(BOT_SESSION, BOT_API_ID, BOT_API_HASH)
SUPER_ID = None

_ui = {}
_active_connect = {}


def MAIN_TEXT(uid):
    if is_super(uid):
        return "**NIK bot — OWNER**\n\nTap any function below."
    if is_admin(uid):
        return "**NIK bot — ADMIN**\n\nlink · add · report · grant premium"
    if is_user_granted_premium(uid):
        exp = user_premium_expiry_str(uid)
        active = is_user_premium(uid)
        if active:
            return (f"**NIK bot — PREMIUM ✅**\n\n"
                    f"**premium left: {exp}**\n\n"
                    "tap a function below.")
        return (f"**NIK bot — PREMIUM ⏰ EXPIRED**\n\n"
                f"**premium left: {exp}**\n\n"
                "your premium has ended.\ncontact admin to renew.")
    return (f"**NIK bot — USER**\n\n"
            f"**premium left: {user_premium_expiry_str(uid)}**\n\n"
            "tap a function below.")


async def gate_ok(event) -> bool:
    uid = event.sender_id
    if is_super(uid):
        return True
    try:
        joined = await is_joined_required(uid)
    except Exception:
        joined = False
    if joined:
        return True
    try:
        sender = await event.get_sender()
        uname = getattr(sender, "username", None)
    except Exception:
        uname = None
    if not is_admin(uid):
        ensure_user_registered(uid, uname)
    try:
        await event.respond(GATE_TEXT, buttons=join_gate_buttons())
    except Exception:
        pass
    return False


@bot.on(events.NewMessage(pattern=r"^/start"))
async def cmd_start(e):
    uid = e.sender_id
    try:
        sender = await e.get_sender()
        uname = getattr(sender, "username", None)
    except Exception:
        uname = None
    if not is_admin(uid):
        ensure_user_registered(uid, uname)
    if not await gate_ok(e):
        return
    await e.reply(MAIN_TEXT(uid), buttons=main_menu_buttons(uid))


@bot.on(events.CallbackQuery(pattern=rb"^gate:check$"))
async def cb_gate_check(event):
    uid = event.sender_id
    try:
        sender = await event.get_sender()
        uname = getattr(sender, "username", None)
    except Exception:
        uname = None
    if not is_admin(uid):
        ensure_user_registered(uid, uname)
    if await is_joined_required(uid):
        await event.edit(MAIN_TEXT(uid), buttons=main_menu_buttons(uid))
    else:
        await event.answer("still not in both channels", alert=True)


@bot.on(events.CallbackQuery(pattern=rb"^menu:"))
async def cb_menu(event):
    uid = event.sender_id
    if not (is_super(uid) or is_admin(uid) or is_user(uid)):
        await event.answer("no access"); return
    if not await gate_ok(event):
        return
    action = event.data.decode().split(":", 1)[1]

    if action == "main":
        await event.edit(MAIN_TEXT(uid), buttons=main_menu_buttons(uid)); return
    if action == "close":
        await event.delete(); return

    if action == "support":
        await event.edit(
            f"**💬 HELP**\n\n"
            f"admin telegram id:\n"
            f"👉 `@{SUPPORT_ID}`\n\n"
            f"to contact privately, tap **📞 CONTACT ADMIN**.",
            buttons=[
                [Button.inline("📞  CONTACT ADMIN", data=b"menu:contact_admin")],
                [Button.inline("◀  BACK", data=b"menu:main")],
            ],
        )
        return

    if action == "contact_admin":
        _ui[uid] = {"stage": "await_support_msg"}
        await event.edit(
            "**📞 CONTACT ADMIN**\n\n"
            "type your message here.\n"
            "it will be delivered privately to the owner.",
            buttons=[[Button.inline("❌  CANCEL", data=b"menu:main")]],
        )
        return

    if action == "capture_id":
        if not (is_super(uid) or is_admin(uid)):
            await event.answer("no access"); return
        _ui[uid] = {"stage": "await_capture_forward"}
        await event.edit(
            "**🆔 CAPTURE USER ID**\n\n"
            "forward any message from the user\n"
            "OR send their @username\n"
            "OR send their numeric id\n\n"
            "the bot will reply with their numeric telegram id.",
            buttons=[[Button.inline("❌  CANCEL", data=b"menu:main")]],
        )
        return

    if action in ("report", "report_channel"):
        allowed = is_super(uid) or is_admin(uid)
        if not allowed:
            if is_user_granted_premium(uid):
                allowed = is_user_premium(uid)
            else:
                allowed = False
        if not allowed:
            if is_user_granted_premium(uid) and not is_user_premium(uid):
                await event.answer("⏰ premium expired — contact admin", alert=True)
            else:
                await event.answer("no premium — contact admin", alert=True)
            return
        _ui[uid] = {"stage": "await_target", "mode": action}
        if action == "report":
            await event.edit(
                "**🎯 REPORT USERNAME / ID**\n\n"
                "reply with the target:\n"
                "• username — e.g. `@scammer123`\n"
                "• numeric id — e.g. `1234567890`",
                buttons=[[Button.inline("❌  CANCEL", data=b"menu:main")]],
            )
        else:
            await event.edit(
                "**📣 REPORT CHANNEL**\n\n"
                "reply with the channel:\n"
                "• username — e.g. `@spamchannel`\n"
                "• numeric id — e.g. `1234567890`",
                buttons=[[Button.inline("❌  CANCEL", data=b"menu:main")]],
            )
        return

    if action in ("add", "connect"):
        if not (is_super(uid) or is_admin(uid)):
            await event.answer("no access"); return
        if action == "add":
            _ui[uid] = {"stage": "await_phone"}
            await event.edit(
                "**ADD ACCOUNT**\n\n"
                "reply with the phone in `+` format.\n"
                "example: `+919999999999`",
                buttons=[[Button.inline("◀  BACK", data=b"menu:main")]],
            )
            return
        rows, count = phone_buttons()
        if count == 0:
            await event.edit(
                "**no pending accounts.**\n\nfirst ➕ ADD ACCOUNT.",
                buttons=[
                    [Button.inline("➕  ADD ACCOUNT", data=b"menu:add")],
                    [Button.inline("◀  BACK", data=b"menu:main")],
                ],
            )
            return
        await event.edit("**LINK ACCOUNT — pick phone:**", buttons=rows)
        return

    if action == "list":
        if not is_super(uid):
            await event.answer("owner only"); return
        if not list_sessions():
            await event.edit("no accounts linked yet.",
                             buttons=[[Button.inline("◀  BACK", data=b"menu:main")]])
            return
        await event.edit(f"**{len(list_sessions())} linked accounts** (owner view):",
                         buttons=linked_accounts_buttons(uid))
        return

    if action == "remove":
        if not is_super(uid):
            await event.answer("owner only"); return
        if not list_sessions():
            await event.edit("no accounts to remove.",
                             buttons=[[Button.inline("◀  BACK", data=b"menu:main")]])
            return
        await event.edit("**REMOVE ACCOUNT — pick:**",
                         buttons=linked_accounts_buttons(uid))
        return

    if action == "admins":
        if not is_super(uid):
            await event.answer("owner only"); return
        await event.edit("**ADMIN PANEL** — tap:", buttons=admin_list_buttons())
        return

    if action == "add_admin":
        if not is_super(uid):
            await event.answer("owner only"); return
        if count_admins() >= MAX_ADMINS:
            await event.answer(f"admin slots full ({MAX_ADMINS}/{MAX_ADMINS})", alert=True)
            return
        _ui[uid] = {"stage": "await_add_admin"}
        await event.edit(
            "**ADD ADMIN**\n\n"
            "reply with the username (`@name`) **OR** numeric id.",
            buttons=[[Button.inline("◀  BACK", data=b"menu:main")]],
        )
        return

    if action == "remove_admin":
        if not is_super(uid):
            await event.answer("owner only"); return
        await event.edit("**REMOVE ADMIN** — tap:", buttons=admin_list_buttons())
        return

    if action == "grant_premium":
        if not (is_super(uid) or is_admin(uid)):
            await event.answer("no access"); return
        _ui[uid] = {"stage": "await_grant_premium"}
        await event.edit(
            "**GRANT PREMIUM**\n\n"
            "reply with the target **AND** number of days.\n\n"
            "examples:\n"
            "• `@user 30` — username, 30 days\n"
            "• `1234567890 30` — numeric id, 30 days",
            buttons=[[Button.inline("◀  BACK", data=b"menu:main")]],
        )
        return

    if action == "premium_list":
        if not (is_super(uid) or is_admin(uid)):
            await event.answer("no access"); return
        await event.edit("**PREMIUM USERS** — tap:", buttons=premium_list_buttons())
        return

    if action == "revoke_premium":
        if not is_super(uid):
            await event.answer("owner only"); return
        await event.edit("**REVOKE PREMIUM** — tap:", buttons=premium_list_buttons())
        return

    if action == "status":
        if not is_super(uid):
            await event.answer("owner only"); return
        stats = load_stats()
        if not stats:
            await event.edit("no reports yet.",
                             buttons=[[Button.inline("◀  BACK", data=b"menu:main")]])
            return
        lines = [f"`{t}` — ✅ {s['ok']} / ❌ {s['fail']} / {s['runs']} runs"
                 for t, s in stats.items()]
        await event.edit("**LIFETIME STATS**\n\n" + "\n".join(lines),
                         buttons=[[Button.inline("◀  BACK", data=b"menu:main")]])
        return

    if action == "pool":
        if not is_super(uid):
            await event.answer("owner only"); return
        lines = [f"• **{label}** — region `{region}` — api_id `{api_id}`"
                 for api_id, _, region, label in API_POOL]
        await event.edit("**API POOL**\n\n" + "\n".join(lines),
                         buttons=[[Button.inline("◀  BACK", data=b"menu:main")]])
        return

    if action == "support_inbox":
        if not is_super(uid):
            await event.answer("owner only"); return
        await event.edit("**📬 SUPPORT INBOX** — tap:",
                         buttons=support_inbox_buttons())
        return

    await event.answer("unknown")


@bot.on(events.CallbackQuery(pattern=rb"^phone:"))
async def cb_phone(event):
    uid = event.sender_id
    if not (is_super(uid) or is_admin(uid)):
        await event.answer("no access"); return
    phone = event.data.decode().split(":", 1)[1]
    _ui[uid] = {"stage": "pick_pair", "phone": phone}
    await event.edit(
        f"**LINK ACCOUNT**\n\n"
        f"phone: `{phone}`\n\n"
        f"**pick api pair:**",
        buttons=pair_buttons(),
    )


@bot.on(events.CallbackQuery(pattern=rb"^pair:"))
async def cb_pair(event):
    uid = event.sender_id
    if not (is_super(uid) or is_admin(uid)):
        await event.answer("no access"); return
    api_id = int(event.data.decode().split(":", 1)[1])
    phone = (_ui.get(uid) or {}).get("phone")
    if not phone:
        await event.answer("expired"); return
    _ui.pop(uid, None)
    label = next((p[3] for p in API_POOL if p[0] == api_id), str(api_id))
    _active_connect[phone] = uid

    await event.edit(
        f"**LINKING**\n"
        f"via **{label}** ({api_id})\n\n"
        "⏳ telegram is sending the code now...\n\n"
        "**where the code arrives:**\n"
        "• the **Telegram app** — chat named **Telegram** (blue checkmark)\n"
        "• or by **SMS**\n\n"
        "**reply here with the code.**\n"
        "if not received, reply `resend`."
    )

    result = await connect_one(phone, preferred_api=api_id, owner_id=uid)
    _active_connect.pop(phone, None)

    if result["ok"]:
        await event.respond(f"✅ linked via {label}", buttons=[
            [Button.inline("🔗  LINK ANOTHER", data=b"menu:connect")],
            [Button.inline("◀  MENU", data=b"menu:main")],
        ])
    else:
        await event.respond(f"❌ failed: {result['message']}", buttons=[
            [Button.inline("🔗  TRY AGAIN", data=b"menu:connect")],
            [Button.inline("◀  MENU", data=b"menu:main")],
        ])


@bot.on(events.CallbackQuery(pattern=rb"^reason:"))
async def cb_reason(event):
    uid = event.sender_id
    allowed = is_super(uid) or is_admin(uid)
    if not allowed:
        if is_user_granted_premium(uid):
            allowed = is_user_premium(uid)
        else:
            allowed = False
    if not allowed:
        if is_user_granted_premium(uid) and not is_user_premium(uid):
            await event.answer("⏰ premium expired", alert=True)
        else:
            await event.answer("no premium", alert=True)
        return
    key = event.data.decode().split(":", 1)[1]
    target = (_ui.get(uid) or {}).get("target")
    if target is None:
        await event.answer("expired"); return
    _ui.pop(uid, None)

    target_display = target if isinstance(target, str) else str(target)
    label = REPORT_REASONS.get(key, {}).get("label", key)
    await event.edit(f"firing {target_display}\n**{label}**\nfrom {len(list_sessions())} accounts...")

    async def progress(i, total, sess, ok, viewer):
        try:
            display = sess[:-8] if is_super(viewer) else f"acct{i}"
            await event.edit(
                f"firing {target_display} · **{label}**\n"
                f"{i}/{total}\n"
                f"last: `{display}` {'✅' if ok else '❌'}"
            )
        except Exception:
            pass

    summary = await run_report(target, reason_key=key, progress_cb=progress, viewer_uid=uid)
    if summary.get("error"):
        await event.edit(f"[x] {summary['error']}",
                         buttons=[[Button.inline("◀  BACK", data=b"menu:main")]])
        return
    out = (f"**{target_display}** · **{label}**\n\n"
           f"✅ {summary['ok']} ok · ❌ {summary['fail']} fail")
    if is_super(uid) and REPLY_PER_ACCOUNT:
        fails = [r for r in summary["results"] if not r["ok"]]
        if fails:
            out += "\n\n**failures:**\n" + "\n".join(
                f"• `{r['session'][:-8]}`: {r['error'][:100]}" for r in fails[:10]
            )
    await event.edit(out, buttons=[[Button.inline("◀  MENU", data=b"menu:main")]])


@bot.on(events.CallbackQuery(pattern=rb"^acct:"))
