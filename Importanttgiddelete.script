}


def parse_target(text: str):
    m = TARGET_RE.match(text)
    if m:
        return ("username", m.group(1))
    m = NUMERIC_ID_RE.match(text)
    if m:
        return ("id", m.group(1))
    return (None, None)


def _validate_pool():
    if not API_POOL:
        raise ValueError("API_POOL is empty")
    seen = set()
    for entry in API_POOL:
        if len(entry) != 4:
            raise ValueError(f"pool entry must be (id, hash, region, label): {entry!r}")
        api_id, api_hash, region, label = entry
        if not isinstance(api_id, int):
            raise ValueError(f"api_id must be int: {api_id!r}")
        if api_id in seen:
            raise ValueError(f"duplicate api_id: {api_id}")
        seen.add(api_id)
        if not isinstance(api_hash, str) or len(api_hash) != 32:
            raise ValueError(f"api_hash for {api_id} bad length: {api_hash!r}")
        if not all(c in "0123456789abcdef" for c in api_hash.lower()):
            raise ValueError(f"api_hash for {api_id} non-hex: {api_hash!r}")
        if not isinstance(region, str) or not region:
            raise ValueError(f"region missing for {api_id}")
        if not isinstance(label, str) or not label:
            raise ValueError(f"label missing for {api_id}")


_validate_pool()
print(f"[*] api pool validated: {len(API_POOL)} pair(s)")

# print ReportRequest signature so we can see what this telethon build accepts
try:
    print("[*] ReportRequest signature:",
          inspect.signature(functions.messages.ReportRequest.__init__))
except Exception as _e:
    print("[!] could not inspect ReportRequest:", _e)


def call_report_request(client, peer, reason_obj):
    """call ReportRequest with whatever signature this telethon build wants."""
    RR = functions.messages.ReportRequest
    try:
        params = inspect.signature(RR.__init__).parameters
    except Exception:
        params = {}

    kwargs = {}
    # peer / id
    if "peer" in params:
        kwargs["peer"] = peer
    elif "id" in params:
        kwargs["id"] = peer
    # reason
    if "reason" in params:
        kwargs["reason"] = reason_obj

    # try keyword form if we have a valid mapping, else positional
    if kwargs:
        try:
            return RR(**kwargs)
        except TypeError:
            pass
    # positional fallback — every version accepts at least these two
    try:
        return RR(peer, reason_obj)
    except TypeError:
        # last resort: just peer
        return RR(peer)


def get_reason_obj(reason_key: str):
    spec = REPORT_REASONS.get(reason_key) or REPORT_REASONS[DEFAULT_REASON]
    suffix = spec["reason"]
    for c in (f"InputReportReason{suffix}", f"ReportReason{suffix}"):
        cls = getattr(types, c, None)
        if cls is not None:
            try:
                return cls()
            except Exception:
                continue
    try:
        from telethon.tl.types import InputReportReasonSpam
        return InputReportReasonSpam()
    except Exception:
        return None


# ─────────────────── ADMINS ───────────────────────────────────
def load_admins():
    if ADMINS_FILE.exists():
        try:
            return json.loads(ADMINS_FILE.read_text())
        except Exception:
            return {}
    return {}


def save_admins(data):
    ADMINS_FILE.write_text(json.dumps(data, indent=2))


def is_super(user_id: int) -> bool:
    entry = load_admins().get(str(user_id))
    return bool(entry and entry.get("super"))


def is_admin(user_id: int) -> bool:
    return str(user_id) in load_admins()


def count_admins() -> int:
    admins = load_admins()
    return sum(1 for u, e in admins.items() if not e.get("super"))


def add_admin(user_id: int, username: str):
    admins = load_admins()
    admins[str(user_id)] = {"username": username, "super": False}
    save_admins(admins)


def remove_admin(user_id: int):
    admins = load_admins()
    admins.pop(str(user_id), None)
    save_admins(admins)


# ─────────────────── USERS + PREMIUM ──────────────────────────
def load_users():
    if USERS_FILE.exists():
        try:
            return json.loads(USERS_FILE.read_text())
        except Exception:
            return {}
    return {}


def save_users(data):
    USERS_FILE.write_text(json.dumps(data, indent=2))


def get_user_entry(user_id: int):
    return load_users().get(str(user_id))


def is_user(user_id: int) -> bool:
    return str(user_id) in load_users()


def is_user_premium(user_id: int) -> bool:
    e = get_user_entry(user_id)
    if not e or not e.get("premium"):
        return False
    exp = e.get("premium_until")
    if exp is None:
        return True
    try:
        return datetime.now(timezone.utc) < datetime.fromisoformat(exp)
    except Exception:
        return False


def is_user_granted_premium(user_id: int) -> bool:
    e = get_user_entry(user_id)
    return bool(e and e.get("premium"))


def user_premium_expiry_str(user_id: int) -> str:
    e = get_user_entry(user_id) or {}
    exp = e.get("premium_until")
    if not exp:
        return "no premium"
    try:
        dt = datetime.fromisoformat(exp)
        remaining = dt - datetime.now(timezone.utc)
        if remaining.total_seconds() <= 0:
            return "0d 0h"
        return f"{remaining.days}d {remaining.seconds//3600}h"
    except Exception:
        return "unknown"


def grant_user_premium(user_id: int, username: str, days: int):
    users = load_users()
    exp = datetime.now(timezone.utc) + timedelta(days=days)
    users[str(user_id)] = {
        "username": username,
        "premium": True,
        "premium_until": exp.isoformat(),
    }
    save_users(users)


def revoke_user_premium(user_id: int) -> bool:
    users = load_users()
    if str(user_id) in users:
        users[str(user_id)]["premium"] = False
        users[str(user_id)]["premium_until"] = None
        save_users(users)
        return True
    return False


def count_user_premiums() -> int:
    return sum(1 for e in load_users().values() if e.get("premium"))


def ensure_user_registered(uid: int, uname: str = None):
    users = load_users()
    if str(uid) not in users:
        users[str(uid)] = {
            "username": uname or f"user{uid}",
            "premium": False,
            "premium_until": None,
        }
        save_users(users)
        return True
    return False


# ─────────────────── REGION / PAIR ───────────────────────────
def region_of_phone(phone: str) -> str:
    if not phone:
        return "unknown"
    matches = [p for p in PHONE_REGION if phone.startswith(p)]
    if not matches:
        return "unknown"
    return PHONE_REGION[max(matches, key=len)]


def ordered_pairs_for(phone: str, preferred: int = None):
    want = region_of_phone(phone)
    pref = [p for p in API_POOL if p[0] == preferred]
    region = [p for p in API_POOL if p[2] == want and p[0] != preferred]
    rest = [p for p in API_POOL if p not in pref and p not in region]
    return pref + region + rest


